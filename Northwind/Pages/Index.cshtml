@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
@*Title of the page*@

<div class="text-center">
    <h1 class="display-4">Welcome to Northwind Traders</h1>
    <img src="https://www.microsoft.com/en-us/power-platform/blog/wp-content/uploads/2019/06/nwindlogo.webp" alt="Northwind Foods" class="img-fluid my-4" />
    <p class="lead">
        Northwind Traders is a gourmet food import and export company,
        specializing in bringing the finest delicacies from around the world to your table.
        Explore our wide range of products and meet our customers from many countries!
    </p>
</div>
@*This div contains the main contents of the page. In order, these are h1 text that welcomes users, 
an image sourced from the microsoft website. and a paragraph giving a short explanation of the purpose of the page. *@
